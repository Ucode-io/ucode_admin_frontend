{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/components/*": ["src/components/*"],
      "@/utils/*": ["src/utils/*"],
      "@/hooks/*": ["src/hooks/*"],
      "@/services/*": ["src/services/*"],
      "@/views/*": ["src/views/*"],
      "@/providers/*": ["src/providers/*"],
      "@/store/*": ["src/store/*"],
      "@/theme/*": ["src/theme/*"],
      "@/mock/*": ["src/mock/*"],
      "@/assets/*": ["src/assets/*"],
      "@/workers/*": ["src/workers/*"]
    }
  },
  "exclude": [
    "node_modules",
    ".next",
    "out",
    "dist",
    "build",
    ".cache",
    "coverage",
    "**/*.spec.js",
    "**/*.test.js"
  ]
}